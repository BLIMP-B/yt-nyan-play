{
  "name": "yt-nyan-play",
  "version": "0.2.0",
  "private": true,
  "description": "にゃんぷれい Chrome拡張とWindows Discord.js統合アプリ",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "package": "python3 scripts/package.py",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "check:desktop": "node scripts/check-desktop.mjs",
    "dist:win": "electron-builder --win --x64",
    "dist:dir": "electron-builder --dir",
    "smoke:desktop": "node scripts/smoke-desktop.mjs"
  },
  "type": "module",
  "main": "apps/desktop/main.mjs",
  "author": "BLIMP-B",
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "discord.js": "14.27.0",
    "ffmpeg-static": "5.3.0",
    "opusscript": "0.1.1",
    "re2-wasm": "1.0.2"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "playwright-core": "1.58.2"
  },
  "extensionVersion": "0.1.2",
  "license": "UNLICENSED",
  "build": {
    "appId": "jp.blimp.nyanplay",
    "productName": "NyanPlay",
    "directories": {
      "output": "dist/desktop"
    },
    "files": [
      "apps/desktop/**/*",
      "extension/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/**/*.node"
    ],
    "extraResources": [
      {
        "from": "extension",
        "to": "chrome-extension"
      },
      {
        "from": "docs",
        "to": "docs"
      },
      {
        "from": "THIRD_PARTY.md",
        "to": "THIRD_PARTY.md"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "NyanPlay-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "artifactName": "NyanPlay-Setup-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "dir"
      ]
    }
  }
}
