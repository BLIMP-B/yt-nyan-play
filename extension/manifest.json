{
  "manifest_version": 3,
  "name": "にゃんぷれい",
  "version": "0.2.1",
  "description": "YouTube・ニコニコ・SNSの動画や音声から、再生指定と開始位置を選んでDiscordへ送信します。",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://youtu.be/*",
    "https://*.nicovideo.jp/*",
    "https://nico.ms/*",
    "https://*.x.com/*",
    "https://*.twitter.com/*",
    "https://*.instagram.com/*",
    "https://*.tiktok.com/*",
    "https://*.facebook.com/*",
    "https://fb.watch/*",
    "https://*.threads.net/*",
    "https://*.threads.com/*",
    "https://bsky.app/*",
    "https://*.mastodon.social/*",
    "https://*.mastodon.online/*",
    "https://mstdn.jp/*",
    "https://pawoo.net/*",
    "https://discord.com/api/webhooks/*",
    "https://discordapp.com/api/webhooks/*"
  ],
  "icons": {
    "16": "furoneko70furoneko70.png",
    "32": "furoneko70furoneko70.png",
    "48": "furoneko70furoneko70.png",
    "128": "furoneko70furoneko70.png"
  },
  "action": {
    "default_icon": {
      "16": "furoneko70furoneko70.png",
      "32": "furoneko70furoneko70.png",
      "48": "furoneko70furoneko70.png",
      "128": "furoneko70furoneko70.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "furoneko70furoneko70.png"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://youtu.be/*",
        "https://*.nicovideo.jp/*",
        "https://nico.ms/*",
        "https://*.x.com/*",
        "https://*.twitter.com/*",
        "https://*.instagram.com/*",
        "https://*.tiktok.com/*",
        "https://*.facebook.com/*",
        "https://fb.watch/*",
        "https://*.threads.net/*",
        "https://*.threads.com/*",
        "https://bsky.app/*",
        "https://*.mastodon.social/*",
        "https://*.mastodon.online/*",
        "https://mstdn.jp/*",
        "https://pawoo.net/*"
      ],
      "js": [
        "media-adapters.js",
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}
